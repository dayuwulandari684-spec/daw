# ── Salin file ini menjadi .env dan isi nilainya ──────────────────────────────

# 1. Daftar di https://developers.tiktok.com → buat app → dapatkan keys
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here
TIKTOK_ACCESS_TOKEN=your_access_token_here          # diisi setelah OAuth
TIKTOK_REDIRECT_URI=http://localhost:8080/callback

# 2. TikTok Shop Affiliate → https://affiliate.tiktok.com/connection/creator
TIKTOK_SHOP_APP_KEY=your_shop_app_key
TIKTOK_SHOP_APP_SECRET=your_shop_app_secret
TIKTOK_SHOP_ACCESS_TOKEN=your_shop_access_token

# 3. OpenAI (opsional – jika kosong, pakai template bawaan)
OPENAI_API_KEY=sk-...
